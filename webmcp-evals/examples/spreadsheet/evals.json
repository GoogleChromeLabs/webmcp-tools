  {
    "name": "Spreadsheet: Delete a column and fit the widths",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Starting at A1, enter the headers Name, Notes and Total and the row Ana, call back, 12. Then delete column B and fit columns A:B to their content."
      }
    ],
    "expectedCall": [
      {
        "functionName": "set_values",
        "arguments": {
          "range": "A1",

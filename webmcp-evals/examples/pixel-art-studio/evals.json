            { "x": 14, "y": 30 }
          ],
          "color": "#ffffff"
        }
      }
    ]
  },
  {
    "name": "Pixel Art Studio: Paint a heart from rows and read it back",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Paint this heart with its top-left corner at (24, 24), where P is #ff4d8d: '.PP.PP.', 'PPPPPPP', 'PPPPPPP', '.PPPPP.', '..PPP..', '...P...'. Then read back that 7 by 6 area to check it."
      }
    ],
    "expectedCall": [
      {
        "functionName": "paint_rows",
        "arguments": {
          "x": 24,
          "y": 24,
          "rows": [".PP.PP.", "PPPPPPP", "PPPPPPP", ".PPPPP.", "..PPP..", "...P..."],
          "legend": {
            "P": "#ff4d8d"
          }
        }
      },
      {
        "functionName": "get_region_pixels",
        "arguments": {
          "x": 24,
          "y": 24,
          "width": 7,
          "height": 6
        }
      }
    ]
  },

  {
    "name": "Pixel Art Studio: Replace a selected area with art",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Select the 6 by 6 area at (29, 29) and replace it with a white cross, where W is #ffffff: '..WW..', '..WW..', 'WWWWWW', 'WWWWWW', '..WW..', '..WW..'."
      }
    ],
    "expectedCall": [
      {
        "functionName": "set_selection",
        "arguments": {
          "x": 29,
          "y": 29,
          "width": 6,
          "height": 6
        }
      },
      {
        "functionName": "replace_selection",
        "arguments": {
          "mode": "rows",
          "rows": ["..WW..", "..WW..", "WWWWWW", "WWWWWW", "..WW..", "..WW.."],
          "legend": {
            "W": "#ffffff"
          }
        }
      }
    ]
  },
  {

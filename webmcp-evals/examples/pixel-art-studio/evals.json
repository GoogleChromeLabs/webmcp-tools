          "height": 12,
          "color": "#5ee0e6",
          "filled": false
        }
      },
      {
        "functionName": "flood_fill",
        "arguments": {
          "x": 10,
          "y": 10,
          "color": "#ff7b5c"
        }
      }
    ]
  },
  {
    "name": "Pixel Art Studio: Circle and thick line",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Draw a filled #ffc145 circle in the 16 by 16 box at (40, 8), then draw a 2-pixel-thick #fff3b0 line from (4, 48) to (60, 48)."
      }
    ],
    "expectedCall": [
      {
        "functionName": "draw_ellipse",
        "arguments": {
          "x": 40,
          "y": 8,
          "width": 16,
          "height": 16,
          "color": "#ffc145"

[
  {
    "name": "Pixel Art Studio: Read canvas info",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "What canvas size and color palette am I working with?"
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_canvas_info",
        "arguments": {}
      }
    ]
  },
  {
    "name": "Pixel Art Studio: Resize the canvas and show the grid",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Make the canvas 128 by 128 pixels, then fit it to the screen and turn on the pixel grid."
      }
    ],
    "expectedCall": [
      {
        "functionName": "set_canvas_size",
        "arguments": {
          "size": 128
        }
      },
      {
        "functionName": "set_view",
        "arguments": {
          "fit": true,
          "grid": true
        }
      }
    ]
  },
  {
    "name": "Pixel Art Studio: Sunset sky with a sun",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Fill the canvas with a vertical sunset gradient from #2d1457 through #e23a6e to #ffc145 using Bayer 4x4 dithering, then draw a 16-pixel sun at (32, 20) in #ffe066 with #ff9f4a rays."
      }
    ],
    "expectedCall": [
      {
        "functionName": "gradient_fill",
        "arguments": {
          "colors": ["#2d1457", "#e23a6e", "#ffc145"],
          "direction": "vertical",
          "dither": "bayer4"
        }
      },
      {
        "functionName": "draw_shape_preset",
        "arguments": {
          "shape": "sun",
          "x": 32,
          "y": 20,
          "size": 16,
          "color": "#ffe066",
          "color2": "#ff9f4a"
        }
      }
    ]
  },
  {
    "name": "Pixel Art Studio: Draw a scene from SVG",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Draw this SVG with a #0b0723 outline: <svg viewBox='0 0 64 64'><rect y='44' width='64' height='20' fill='#1f9eb8'/><circle cx='32' cy='40' r='10' fill='#ffe066'/></svg>"
      }
    ],
    "expectedCall": [
      {
        "functionName": "draw_svg",
        "arguments": {
          "svg": "<svg viewBox='0 0 64 64'><rect y='44' width='64' height='20' fill='#1f9eb8'/><circle cx='32' cy='40' r='10' fill='#ffe066'/></svg>",
          "outline": "#0b0723"
        }
      }
    ]
  },
  {
    "name": "Pixel Art Studio: Outlined rectangle with a bucket fill",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Draw an outlined #5ee0e6 rectangle at (4, 4) that is 20 pixels wide and 12 pixels tall, then bucket-fill its inside at (10, 10) with #ff7b5c."
      }
    ],
    "expectedCall": [
      {
        "functionName": "draw_rect",
        "arguments": {
          "x": 4,
          "y": 4,

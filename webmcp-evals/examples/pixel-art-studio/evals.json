      },
      {
        "functionName": "draw_line",
        "arguments": {
          "x0": 4,
          "y0": 48,
          "x1": 60,
          "y1": 48,
          "color": "#fff3b0",
          "thickness": 2
        }
      }
    ]
  },
  {
    "name": "Pixel Art Studio: Paint single pixels",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Paint three #ffffff pixels at (10, 30), (12, 30), and (14, 30)."
      }
    ],
    "expectedCall": [
      {
        "functionName": "draw_pixels",

  {
    "name": "Pixel Art Studio: Fill a lasso selection with noise",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Lasso-select the area with corners (30, 40), (58, 38), (54, 60), and (34, 58), and fill it with random grass noise using #2b8a3e and #40c057."
      }

{
  "name": "webmcp-skills",
  "version": "0.1.0",
  "description": "Agent skills for designing, role-playing, evaluating, and implementing WebMCP tools",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoogleChromeLabs/webmcp-tools.git",
    "directory": "webmcp-skills"
  },
  "type": "module",
  "scripts": {
    "test": "vite-node src/evals/cli.ts",
    "test:unit": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "eval": "vite-node src/evals/cli.ts",
    "eval:full": "vite-node src/evals/cli.ts --mode comparison --runs 3",
    "eval:dry-run": "vite-node src/evals/cli.ts --dry-run",
    "eval:bundle": "vite-node src/evals/cli.ts --bundle-only",
    "eval:view": "vite-node src/eval-viewer/server.ts",
    "skill:validate": "vite-node src/evals/cli.ts --validate skills/build-webmcp-tools",
    "skill:package": "vite-node src/evals/cli.ts --package skills/build-webmcp-tools"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dotenvy": "^0.2.0",
    "eslint-plugin-license-header": "^0.9.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.51.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
